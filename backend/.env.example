# Copy to backend/.env for local runs. Compose reads settings from the root .env.
APP_ENV=development
DATABASE_URL=sqlite:///./vidyutflow.db
SECRET_KEY=dev-only-change-me-in-production-please-32-chars

# Per observed client IP, per API process; counts successful and failed logins.
LOGIN_MAX_ATTEMPTS=20
LOGIN_WINDOW_SECONDS=60

# Demo-only review threshold, not an official UGVCL limit (kW).
DEMO_LOAD_REVIEW_THRESHOLD_KW=100

# Maximum uploaded document size in bytes for POST /requests/with-document (default 5 MiB).
MAX_UPLOAD_BYTES=5242880

# Operational alert engine thresholds (simulated SMS/email + in-app alert centre + audit log).
ALERT_SLA_RISK_THRESHOLD=0.70
ALERT_UNASSIGNED_HOURS=4.0
ALERT_ZONE_FAILURE_THRESHOLD=2

# Epoch-invalidated KPI/template cache TTL (seconds) and rolling latency sample window.
KPI_CACHE_TTL_SECONDS=15.0
LATENCY_WINDOW_SIZE=1000


