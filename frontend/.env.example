# ==============================================================================
# VidyutFlow Environment Configuration Example
# ==============================================================================
# SECURITY NOTICE:
# 1. NEVER commit actual API keys, service tokens, or private secrets to version control.
# 2. NEVER prefix private secrets with "VITE_" — Vite automatically embeds any VITE_-prefixed
#    variables directly into client-side browser JavaScript bundles.
# 3. Fictional prototype accounts (e.g. demo passwords in demoAuthData) are strictly for local
#    browser UI demonstration and are distinct from live API secrets.
# ==============================================================================

# GEMINI_API_KEY: Server-side API key for Google Gemini model access.
# - In Google AI Studio: Injected automatically at runtime via user secrets.
# - In Production Backend: Injected as an environment secret in Cloud Run / container runtime.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The public base URL where this application is hosted.
# Used for self-referential links, OAuth redirects, and internal API routing.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Server-side HMAC-SHA256 signing secret for HttpOnly session cookies (>= 32 chars in production).
# Never prefix with VITE_. In development/test, an ephemeral 256-bit key is generated if omitted.
SESSION_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_SERVER_SECRET"

